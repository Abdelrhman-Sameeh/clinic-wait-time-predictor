# LLM provider: extractive (offline), openai, or anthropic.
LLM_PROVIDER=extractive
# OpenAI API key; only needed when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# OpenAI model name; only needed when LLM_PROVIDER=openai.
OPENAI_MODEL=
# Anthropic API key; only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Anthropic model name; only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_MODEL=
# Staff/admin key; required for staff/admin endpoints. Set a long random value.
STAFF_API_KEY=
# Base URL used by the Streamlit UI to contact the API.
API_URL=http://localhost:8000
# SQLite database path used by the API.
DB_PATH=data/clinic.sqlite
# ChromaDB persistence directory used by the API.
CHROMA_DIR=chroma_db
# Seed the sample config on API startup only if no config is saved.
SEED_SAMPLE_CONFIG=true
